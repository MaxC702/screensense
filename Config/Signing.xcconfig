// ScreenBlock — the only file you need to edit to build this on your own device.
//
// Everything downstream (four bundle IDs, four entitlements files, and the
// App Group identifier baked into each Info.plist) is derived from these two
// values, so they can never drift out of sync.

// 1. Your 10-character Apple Developer Team ID.
//    Find it at https://developer.apple.com/account under Membership Details,
//    or in Xcode: Settings -> Accounts -> your Apple ID -> Team.
//    A free "Personal Team" can work but hits a 10-App-IDs-per-7-days cap that
//    this 4-target app is quick to exhaust. See the README before you start.
DEVELOPMENT_TEAM = X9YN79V4C8

// 2. Reverse-DNS prefix for the app. Extensions get .monitor / .shieldconfig /
//    .shieldaction appended automatically. Must be unique to you.
//
//    Still says "screenblock" after the app was renamed to ScreenSense, and that
//    is deliberate. Bundle IDs are invisible to users, but changing this one
//    changes the App Group derived from it on the line below — which means a new,
//    empty shared container, and every streak, every day of history and the
//    chosen apps left behind in the old one. A legacy identifier is the cheaper
//    of the two, by a distance.
BUNDLE_ID_PREFIX = com.chernobayev.screenblock

// 3. The App Group is the shared container the app and its three extensions use
//    to agree on how many breaks are left. Apple requires the "group." prefix.
//    Keep it in step with BUNDLE_ID_PREFIX.
APP_GROUP_ID = group.$(BUNDLE_ID_PREFIX)
